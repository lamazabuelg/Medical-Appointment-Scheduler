# URL de la plataforma médica
HUSI_BASE_URL="https://agendatucita.husi.org.co"

# Credenciales de acceso a HUSI
HUSI_TIPO_DOC="1" # 1: Cédula, 2: T.I, 4: C.E, 3: Pasaporte
HUSI_DOC_NUM="TU_NUMERO_DOCUMENTO"
HUSI_PASSWORD="TU_PASSWORD"

# Criterios para la reprogramación
PREFERENCIA_HORARIO="afternoon" # 'morning' (7-12), 'afternoon' (12-18), o 'any'
PREFERENCIA_DOCTOR="same_doctor" # 'same_doctor', 'any', o nombre específico
MODALIDAD="presencial" # 'presencial', 'virtual', o 'any'
MIN_DAYS_EARLIER="1" # Mínimo de días que debe adelantarse
FECHA_MAXIMA="2026-11-29" # Fecha límite máxima deseada

# Frecuencia de ejecución del script en minutos
POLLING_INTERVAL_MINUTES="5"

# Notificaciones (Alerta real únicamente si hay reprogramación efectiva)
NOTIFICATION_CHANNEL="email" # 'email', 'ntfy', 'telegram', 'all'
NOTIFICATION_EMAIL="tu_correo@gmail.com"
NTFY_TOPIC="husi-citas-alertas"

# Configuración SMTP opcional para envío directo de correos reales (ej. Gmail con Contraseña de Aplicación)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="tu_correo@gmail.com"
SMTP_PASS="tu_contraseña_de_aplicacion_gmail"

TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# GEMINI_API_KEY: Clave de Google GenAI para análisis de decisiones
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
